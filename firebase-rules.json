{
  "rules": {
    "online": {
      "$map": {
        ".read": "$map.matches(/^[a-z0-9]{1,12}$/)",
        "$pid": {
          ".write": "$map.matches(/^[a-z0-9]{1,12}$/) && $pid.matches(/^p[a-z0-9]{6,12}$/)",
          ".validate": "newData.hasChildren(['x', 'y', 't'])",
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 6 && !newData.val().matches(/[<>&]/)" },
          "d": { ".validate": "newData.isString() && newData.val().length <= 5" },
          "sk": { ".validate": "newData.isNumber()" },
          "lv": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
          "st": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 20" },
          "sa": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
